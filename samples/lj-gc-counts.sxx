#!/usr/bin/env stap++

@use luajit_gc64

global full_gc_count = 0;
global lj_gc_step_count = 0;

function output_report() {
    printf("Full GC count: %d\n", full_gc_count)
    printf("lj_gc_step count: %d\n", lj_gc_step_count)
}

probe process("$^libluajit_path").function("gc_mark_gcroot")
{
    full_gc_count++
}

probe process("$^libluajit_path").function("lj_gc_step")
{
    lj_gc_step_count++
}


%( "$^arg_time :default()" != ""  %?
probe timer.s($^arg_time)
{
    warn("Time's up. Quitting now...\n")
    exit()
}
%)

probe end {
    output_report()
}

probe begin
{
    warn(sprintf("Start tracing %d ($^exec_path)\n", target()))
    %( "$^arg_time" != ""  %?
    warn(sprintf("Please wait for $^arg_time seconds...\n"))
    %:
    warn("Hit Ctrl-C to end.\n")
    %)
}
